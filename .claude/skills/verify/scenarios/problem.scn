# Problem page: panels (p/o/c), Tab focus, sync (y), yank (Y); a state.json from the multi-language version still loads.
size 140x40
write .grind-tui/state.json
{"solved":[1],"last_problem_id":1,"language":"rust"}
EOF
launch
wait-for 1/167
key Enter
wait-for var twoSum
expect Two Sum
expect two-sum.js
expect You are given an array
expect-ansi 48;2;255;42;109m Code
key Tab
expect-ansi 48;2;255;42;109m Description
snap focus-description
key Tab
expect-ansi 48;2;255;42;109m Status
key Tab
expect-ansi 48;2;255;42;109m Code
key p p
reject You are given an array
snap desc-collapsed
key p
expect You are given an array
key o o
reject Examples
snap output-collapsed
key o
expect Examples
key c
reject var twoSum
snap code-collapsed
key c
expect var twoSum
key y
expect Synced.
key Y
expect Copied: nvim
expect-file clipboard.txt ~ two-sum.js
key l
expect two-sum.js
reject two-sum.rs
reject impl Solution
snap no-language-switch
key q
expect-exit 0
expect-file .grind-tui/two-sum.js ~ var twoSum = function(nums, target)
reject-file .grind-tui/two-sum.rs
reject-file .grind-tui/state.json ~ language
expect-file .grind-tui/state.json ~ "solved": [

# External editors: blocking vim (v), detached Cursor (C) via stub, untrusted command blocked (X).
size 140x40
write .grind-tui/editors.json
[
  {"name": "vim", "key": "v", "command": "vim", "detach": false},
  {"name": "Cursor", "key": "C", "command": "cursor", "detach": true},
  {"name": "Evil", "key": "X", "command": "rm", "detach": false}
]
EOF
launch
key Enter
wait-for var twoSum
expect v vim
key X
expect Blocked: 'rm' is not a trusted editor
key v
wait-for two-sum.js
snap vim-open
key G o
text // edited in vim
key Escape
text :wq
key Enter
wait-for Reloaded from vim.
expect // edited in vim
snap vim-reloaded
expect-file .grind-tui/two-sum.js ~ // edited in vim
key C
expect Opened in Cursor, auto-syncing on save.
expect live from Cursor · c hide
wait-for Auto-synced from Cursor. ~ 6
key o o
expect // saved by cursor stub
expect Cursor auto-syncs on save
snap cursor-synced
expect-file launched.txt ~ cursor
key q
expect-exit 0
